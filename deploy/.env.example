# Copied to deploy/.env by deploy/scripts/init.sh. Never commit deploy/.env.

# Shared Gateway token: the panel uses it once to pair, then its own device token.
OPENCLAW_GATEWAY_TOKEN=

# Pinned OpenClaw version (decision 5: update only as a separate tested change).
OPENCLAW_VERSION=2026.8.1

# Panel port on the host. Keep 127.0.0.1 and put Caddy / Cloudflare Tunnel in front for HTTPS.
PANEL_BIND=127.0.0.1
PANEL_PORT=8080

CLAWDESK_TZ=UTC
PANEL_LOG_LEVEL=info

# Optional: model keys can also be added later in the panel.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
