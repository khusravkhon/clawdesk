# Copied to deploy/.env by deploy/scripts/init.sh. Never commit deploy/.env.

# Shared Gateway token: the panel uses it once to pair, then its own device token.
OPENCLAW_GATEWAY_TOKEN=

# Pinned OpenClaw version (decision 5: update only as a separate tested change).
OPENCLAW_VERSION=2026.8.1
# Registry: ghcr.io/openclaw/openclaw (primary) or openclaw/openclaw (official Docker Hub mirror).
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw

# Panel port on the host. Keep 127.0.0.1 and put Caddy / Cloudflare Tunnel in front for HTTPS.
PANEL_BIND=127.0.0.1
PANEL_PORT=8080

CLAWDESK_TZ=UTC

# OpenClaw state lives at the same absolute path on the host and inside the Gateway,
# so agent sandbox containers (started via the host Docker socket) see the same workspaces.
CLAWDESK_DATA_DIR=/var/lib/clawdesk
# Group that owns /var/run/docker.sock on the host; init.sh detects it (0 on Docker Desktop).
DOCKER_GID=
# Junior agents run in Docker sandboxes (architecture decision 2). "off" only for hosts without Docker access.
CLAWDESK_SANDBOX=on
PANEL_LOG_LEVEL=info

# Folder on this computer the main agent can read (files/ in its workspace). init.sh defaults it to ~/ClawDesk.
CLAWDESK_FILES_DIR=

# Free models for junior agents (FreeLLMAPI). Pinned; the encryption key protects the
# provider keys stored in its database and is generated by init.sh.
FREELLMAPI_VERSION=v0.13.7
FREELLMAPI_ENCRYPTION_KEY=

# Optional: model keys can also be added later in the panel.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
