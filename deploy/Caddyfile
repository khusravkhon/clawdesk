# HTTPS in front of the panel (compose profile "https"). Caddy gets and renews the Let's Encrypt
# certificate for CLAWDESK_DOMAIN by itself; ports 80 and 443 must be reachable from the internet.
# The panel listens in the Gateway's network namespace, hence the "gateway" host name.
#
# Caddy replaces X-Forwarded-For with the real client address (it trusts no proxy in front of it),
# and the panel believes these headers from the compose network only (TRUST_PROXY).

{$CLAWDESK_DOMAIN} {
	encode zstd gzip

	reverse_proxy {$CLAWDESK_UPSTREAM:gateway:8080}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
