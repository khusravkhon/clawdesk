{
  "id": "operations",
  "mode": "company",
  "role": "specialist",
  "emoji": "🗂️",
  "title": {
    "ru": "Операционный менеджер",
    "en": "Operations manager"
  },
  "description": {
    "ru": "Собирает рабочие задачи, сроки и риски, помогает поддерживать порядок в процессах.",
